{
  "expo": {
    "name": "Vü",
    "slug": "vu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lsaraga.vu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE5"
      },
      "package": "com.lsaraga.vu"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}